{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "monitor": 0,
  "font_family": "CaskaydiaCove Nerd Font",
  "theme": {
    "palette": "Custom",
    "colours": {
      "base_00": { "r": 5,   "g": 8,   "b": 16,  "a": 255 },
      "base_01": { "r": 8,   "g": 12,  "b": 22,  "a": 255 },
      "base_02": { "r": 0,   "g": 136, "b": 170, "a": 255 },
      "base_03": { "r": 26,  "g": 58,  "b": 80,  "a": 255 },
      "base_04": { "r": 45,  "g": 90,  "b": 112, "a": 255 },
      "base_05": { "r": 104, "g": 184, "b": 204, "a": 255 },
      "base_06": { "r": 142, "g": 206, "b": 222, "a": 255 },
      "base_07": { "r": 196, "g": 240, "b": 255, "a": 255 },
      "base_08": { "r": 255, "g": 0,   "b": 68,  "a": 255 },
      "base_09": { "r": 255, "g": 170, "b": 0,   "a": 255 },
      "base_0a": { "r": 255, "g": 170, "b": 0,   "a": 255 },
      "base_0b": { "r": 0,   "g": 204, "b": 119, "a": 255 },
      "base_0c": { "r": 0,   "g": 229, "b": 255, "a": 255 },
      "base_0d": { "r": 0,   "g": 229, "b": 255, "a": 255 },
      "base_0e": { "r": 204, "g": 85,  "b": 255, "a": 255 },
      "base_0f": { "r": 255, "g": 68,  "b": 102, "a": 255 }
    },
    "bar_accent": "Base0C",
    "auto_select_fill": "Base0C",
    "auto_select_text": "Base00",
    "single_border": "Base0C",
    "stack_border": "Base0E",
    "monocle_border": "Base08"
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": false
        },
        "layout": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "show_icon": true
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Update": {
        "enable": true
      }
    },
    {
      "Date": {
        "enable": true,
        "format": "DayDateMonthYear"
      }
    },
    {
      "Time": {
        "enable": true,
        "format": "TwentyFourHour"
      }
    }
  ]
}
