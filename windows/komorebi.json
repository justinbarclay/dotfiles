  "app_specific_configuration_path": "$KOMOREBI_CONFIG_HOME/applications.json",
  "ignore_rules": [
    [
      {
        "kind": "Exe",
        "id": "X410.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Class",
        "id": "IME",
        "matching_strategy": "Equals"
      }
    ]
  ],
  "object_name_change_applications": [
    {
      "kind": "Exe",
      "id": "(?i)^discord\\.exe$",
      "matching_strategy": "Regex"
    },
    {
      "kind": "Exe",
      "id": "(?i)^slack\\.exe$",
      "matching_strategy": "Regex"
    }
  ],
  "slow_application_identifiers": [
    {
      "kind": "Exe",
      "id": "(?i)^discord\\.exe$",
      "matching_strategy": "Regex"
    },
    {
      "kind": "Exe",
      "id": "(?i)^slack\\.exe$",
      "matching_strategy": "Regex"
    }
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "Rows"
        },
        {
          "name": "2",
          "layout": "Rows"
        },
        {
          "name": "3",
          "layout": "Rows"
        },
        {
          "name": "w",
          "layout": "Rows"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "BSP",
          "tile": false,
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "steam.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "steamwebhelper.exe",
              "matching_strategy": "Equals"
