.shell pwsh

# Reload komorebi & whkd config
f24 + oem_comma : komorebic replace-configuration $Env:USERPROFILE/.config/komorebi/komorebi.json ;

# Focus Workspaces (Plural - Focuses workspace index across ALL monitors simultaneously)
f24 + 1 : komorebic focus-workspaces 0
f24 + 2 : komorebic focus-workspaces 1
f24 + 3 : komorebic focus-workspaces 2
f24 + w : komorebic focus-workspaces 3

# Move Window to Workspace on Focused Monitor
f24 + shift + 1 : komorebic move-to-workspace 0
f24 + shift + 2 : komorebic move-to-workspace 1
f24 + shift + 3 : komorebic move-to-workspace 2
f24 + shift + w : komorebic move-to-workspace 3

# Window State Controls
f24 + f     : komorebic toggle-float
f24 + m     : komorebic toggle-monocle
f24 + s     : komorebic toggle-window-container-behaviour
f24 + r     : komorebic flip-layout horizontal
f24 + space : komorebic promote-swap

# Window Focus Navigation (Arrow keys)
f24 + left  : komorebic focus left
f24 + down  : komorebic focus down
f24 + up    : komorebic focus up
f24 + right : komorebic focus right

# Move Window Navigation (Arrow keys)
f24 + shift + left  : komorebic move left
f24 + shift + down  : komorebic move down
f24 + shift + up    : komorebic move up
f24 + shift + right : komorebic move right

# Cycle Focus
f24 + n : komorebic cycle-focus next
f24 + p : komorebic cycle-focus previous

# Resize
f24 + oem_plus  : komorebic resize-axis vertical increase
f24 + oem_minus : komorebic resize-axis vertical decrease
