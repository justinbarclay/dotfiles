            {
              "kind": "Exe",
              "id": "firefox.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Class",
              "id": "MozillaWindowClass",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "3",
          "layout": "BSP"
        },
        {
          "name": "w",
          "layout": "BSP",
          "layout_options": {
            "column_ratios": [0.6]
          },
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "wezterm-gui.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Class",
              "id": "Emacs",
              "matching_strategy": "Equals"
            }
          ]
        }
      ]
    }
  ]
